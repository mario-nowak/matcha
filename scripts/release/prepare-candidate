#!/usr/bin/env bash
# This file was generated by AI.
set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_environment() {
    local name=$1
    [[ -n ${!name:-} ]] || fail "required environment variable is empty: $name"
}

for name in GITHUB_EVENT_NAME GITHUB_OUTPUT GITHUB_REF GITHUB_RUN_ATTEMPT GITHUB_REPOSITORY RUNNER_TEMP; do
    require_environment "$name"
done

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repository_root"

if [[ "$GITHUB_EVENT_NAME" == "workflow_dispatch" ]]; then
    require_environment REQUESTED_VERSION
    [[ "$GITHUB_REF" == "refs/heads/main" ]] || fail "manual releases must run from main, got $GITHUB_REF"
    version=$REQUESTED_VERSION
else
    require_environment PR_NUMBER
    version="0.0.0-pr.${PR_NUMBER}.${GITHUB_RUN_ATTEMPT}"
fi

current_version=$(scripts/release/set-compiler-version --current)
scripts/release/set-compiler-version --dry-run "$version" >/dev/null
tag="matcha-compiler-v$version"
base_sha=$(git rev-parse HEAD)
release_complete=false

if [[ "$GITHUB_EVENT_NAME" == "workflow_dispatch" ]]; then
    git fetch origin main --tags
    origin_main=$(git rev-parse origin/main)
    tag_exists=false

    if git show-ref --verify --quiet "refs/tags/$tag"; then
        tag_exists=true
        tag_sha=$(git rev-list -n 1 "$tag")
        git checkout --detach "$tag_sha"
        base_sha=$tag_sha
        current_version=$(scripts/release/set-compiler-version --current)
        [[ "$current_version" == "$version" ]] || fail "existing tag $tag contains compiler version $current_version"
    elif [[ "$base_sha" != "$origin_main" ]]; then
        fail "workflow source $base_sha is not current origin/main $origin_main"
    fi

    release_json="$RUNNER_TEMP/release.json"
    if gh release view "$tag" --repo "$GITHUB_REPOSITORY" --json isDraft,isPrerelease,assets > "$release_json" 2>/dev/null; then
        [[ "$tag_exists" == true ]] || fail "release $tag exists without a matching tag"

        linux_archive="$tag-linux-x86_64.tar.gz"
        macos_archive="$tag-macos-arm64.tar.gz"
        if jq -e '.isDraft' "$release_json" >/dev/null; then
            printf 'Existing draft release %s will be resumed.\n' "$tag"
        elif jq -e \
            --arg linux "$linux_archive" \
            --arg macos "$macos_archive" \
            '.isPrerelease and ([.assets[].name] | contains([$linux, $macos, "SHA256SUMS.txt"]))' \
            "$release_json" >/dev/null
        then
            release_complete=true
        else
            fail "published release $tag is not a complete compiler prerelease"
        fi
    fi
fi

scripts/release/set-compiler-version "$version"

{
    printf 'base_sha=%s\n' "$base_sha"
    printf 'release_complete=%s\n' "$release_complete"
    printf 'tag=%s\n' "$tag"
    printf 'version=%s\n' "$version"
} >> "$GITHUB_OUTPUT"
