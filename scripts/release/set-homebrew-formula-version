validate_version() {
    candidate=$1
    semver_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

    printf '%s\n' "$candidate" | grep -Eq "$semver_pattern" || fail "invalid semantic version: $candidate"

    case "$candidate" in
        *-*)
            prerelease=${candidate#*-}
            prerelease=${prerelease%%+*}
            old_ifs=$IFS
            IFS=.
            # Word splitting separates semantic-version identifiers.
            # shellcheck disable=SC2086
            set -- $prerelease
