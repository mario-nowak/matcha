set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

[[ $# -eq 2 ]] || fail "usage: scripts/release/generate-checksums VERSION DISTRIBUTION_DIRECTORY"

version=$1
distribution_directory=$2
linux_archive="matcha-compiler-v$version-linux-x86_64.tar.gz"
macos_archive="matcha-compiler-v$version-macos-arm64.tar.gz"

for archive in "$linux_archive" "$macos_archive"; do
    [[ -f "$distribution_directory/$archive" ]] || fail "release archive not found: $distribution_directory/$archive"
done

checksum() {
    local file=$1
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file" | awk '{ print $1 }'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file" | awk '{ print $1 }'
    else
        fail "sha256sum or shasum is required"
    fi
}

manifest="$distribution_directory/SHA256SUMS.txt"
{
    for archive in "$linux_archive" "$macos_archive"; do
        printf '%s  %s\n' "$(checksum "$distribution_directory/$archive")" "$archive"
    done
} > "$manifest"

[[ $(wc -l < "$manifest" | tr -d ' ') == 2 ]] || fail "checksum manifest must contain two entries"
