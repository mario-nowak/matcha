#!/usr/bin/env bash
# This file was generated by AI.
set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

[[ $# -eq 4 ]] || fail "usage: scripts/release/update-tap VERSION TAG RELEASE_REPOSITORY TAP_DIRECTORY"
[[ -n ${GH_TOKEN:-} ]] || fail "GH_TOKEN must contain the Homebrew tap token"
[[ -n ${MATCHA_GITHUB_TOKEN:-} ]] || fail "MATCHA_GITHUB_TOKEN is required"
[[ -n ${RUNNER_TEMP:-} ]] || fail "RUNNER_TEMP is required"

version=$1
tag=$2
release_repository=$3
tap_directory=$4
repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
branch="release/matcha-compiler-v$version"
archive="matcha-compiler-v$version-macos-arm64.tar.gz"
manifest="$RUNNER_TEMP/SHA256SUMS.txt"

GH_TOKEN=$MATCHA_GITHUB_TOKEN gh release download "$tag" \
    --repo "$release_repository" \
    --pattern SHA256SUMS.txt \
    --dir "$RUNNER_TEMP"

sha256=$(awk -v archive="$archive" '$2 == archive { print $1 }' "$manifest")
printf '%s\n' "$sha256" | grep -Eq '^[0-9a-f]{64}$' || fail "macOS archive checksum is missing or invalid"

cd "$tap_directory"
git fetch origin
if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git checkout -B "$branch" "origin/$branch"
else
    git checkout -b "$branch" origin/main
fi

"$repository_root/scripts/release/set-homebrew-formula-version" Formula/matcha-lang.rb "$version" "$sha256"
"$repository_root/scripts/release/verify-homebrew-formula" "$tap_directory" Formula/matcha-lang.rb

git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git add Formula/matcha-lang.rb

if ! git diff --cached --quiet; then
    git commit -m "Update Matcha compiler to v$version"
    git push -u origin "$branch"
fi

existing_pr=$(gh pr list \
    --repo mario-nowak/homebrew-tap \
    --head "$branch" \
    --state open \
    --json url \
    --jq '.[0].url // empty')

if [[ -n "$existing_pr" ]]; then
    printf 'Homebrew tap pull request: %s\n' "$existing_pr"
elif git diff --quiet origin/main...HEAD -- Formula/matcha-lang.rb; then
    printf 'Homebrew formula already contains v%s.\n' "$version"
else
    gh pr create \
        --repo mario-nowak/homebrew-tap \
        --base main \
        --head "$branch" \
        --title "Update Matcha compiler to v$version" \
        --body "Updates Matcha compiler formula to prerelease v$version."
fi

if [[ -n ${GITHUB_STEP_SUMMARY:-} ]]; then
    {
        echo "## Homebrew follow-up"
        echo 'After the tap pull request merges:'
        echo '```sh'
        echo 'brew update'
        echo 'brew upgrade matcha-lang'
        echo 'matcha --version'
        echo '```'
    } >> "$GITHUB_STEP_SUMMARY"
fi
