#!/bin/sh
# This file was generated by AI.
set -eu

usage() {
    cat <<'EOF'
Usage:
  scripts/release/set-compiler-version --current
  scripts/release/set-compiler-version [--dry-run] VERSION
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

validate_version() {
    version=$1
    semver_pattern='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'

    printf '%s\n' "$version" | grep -Eq "$semver_pattern" || fail "invalid semantic version: $version"

    case "$version" in
        *-*)
            prerelease=${version#*-}
            prerelease=${prerelease%%+*}
            old_ifs=$IFS
            IFS=.
            # Word splitting separates semantic-version identifiers.
            # shellcheck disable=SC2086
            set -- $prerelease
            IFS=$old_ifs
            for identifier do
                case "$identifier" in
                    *[!0-9]*) ;;
                    0|[1-9]|[1-9][0-9]*) ;;
                    *) fail "invalid numeric prerelease identifier: $identifier" ;;
                esac
            done
            ;;
    esac
}

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(dirname "$(dirname "$script_dir")")
build_file="$repository_root/matcha-compiler/build.zig"
package_file="$repository_root/matcha-compiler/build.zig.zon"
readme_file="$repository_root/matcha-compiler/README.md"

for file in "$build_file" "$package_file" "$readme_file"; do
    [ -f "$file" ] || fail "required file not found: $file"
done

read_build_version() {
    awk '
        BEGIN {
            prefix = "    build_options.addOption([]const u8, \"version\", \""
            suffix = "\");"
        }
        index($0, prefix) == 1 && substr($0, length($0) - length(suffix) + 1) == suffix {
            value = substr($0, length(prefix) + 1, length($0) - length(prefix) - length(suffix))
            count++
        }
        END {
            if (count != 1) exit 1
            print value
        }
    ' "$build_file"
}

read_package_version() {
    awk '
        BEGIN {
            prefix = "    .version = \""
            suffix = "\","
        }
        index($0, prefix) == 1 && substr($0, length($0) - length(suffix) + 1) == suffix {
            value = substr($0, length(prefix) + 1, length($0) - length(prefix) - length(suffix))
            count++
        }
        END {
            if (count != 1) exit 1
            print value
        }
    ' "$package_file"
}

read_readme_version() {
    awk '
        BEGIN {
            prefix = "fast-moving `v"
            suffix = "` hobby language project"
        }
        {
            start = index($0, prefix)
            if (start > 0) {
                rest = substr($0, start + length(prefix))
                finish = index(rest, suffix)
                if (finish > 0) {
                    value = substr(rest, 1, finish - 1)
                    count++
                }
            }
        }
        END {
            if (count != 1) exit 1
            print value
        }
    ' "$readme_file"
}

build_version=$(read_build_version) || fail "expected one compiler version in matcha-compiler/build.zig"
package_version=$(read_package_version) || fail "expected one package version in matcha-compiler/build.zig.zon"
readme_version=$(read_readme_version) || fail "expected one documented version in matcha-compiler/README.md"

[ "$build_version" = "$package_version" ] || fail "compiler versions differ: build.zig=$build_version, build.zig.zon=$package_version"
[ "$build_version" = "$readme_version" ] || fail "compiler versions differ: build.zig=$build_version, README.md=$readme_version"
validate_version "$build_version"

if [ "${1:-}" = "--current" ]; then
    [ "$#" -eq 1 ] || { usage >&2; exit 1; }
    printf '%s\n' "$build_version"
    exit 0
fi

dry_run=false
if [ "${1:-}" = "--dry-run" ]; then
    dry_run=true
    shift
fi

[ "$#" -eq 1 ] || { usage >&2; exit 1; }
target_version=$1
validate_version "$target_version"

tmp_build="$build_file.release-tmp.$$"
tmp_package="$package_file.release-tmp.$$"
tmp_readme="$readme_file.release-tmp.$$"
cleanup() {
    rm -f "$tmp_build" "$tmp_package" "$tmp_readme"
}
trap cleanup 0 HUP INT TERM

awk -v old="$build_version" -v new="$target_version" '
    BEGIN {
        expected = "    build_options.addOption([]const u8, \"version\", \"" old "\");"
        replacement = "    build_options.addOption([]const u8, \"version\", \"" new "\");"
    }
    $0 == expected {
        print replacement
        count++
        next
    }
    { print }
    END { if (count != 1) exit 1 }
' "$build_file" > "$tmp_build" || fail "could not update compiler version in matcha-compiler/build.zig"

awk -v old="$package_version" -v new="$target_version" '
    BEGIN {
        expected = "    .version = \"" old "\","
        replacement = "    .version = \"" new "\","
    }
    $0 == expected {
        print replacement
        count++
        next
    }
    { print }
    END { if (count != 1) exit 1 }
' "$package_file" > "$tmp_package" || fail "could not update package version in matcha-compiler/build.zig.zon"

awk -v old="$readme_version" -v new="$target_version" '
    BEGIN {
        expected = "fast-moving `v" old "` hobby language project"
        replacement = "fast-moving `v" new "` hobby language project"
    }
    {
        start = index($0, expected)
        if (start > 0) {
            $0 = substr($0, 1, start - 1) replacement substr($0, start + length(expected))
            count++
        }
        print
    }
    END { if (count != 1) exit 1 }
' "$readme_file" > "$tmp_readme" || fail "could not update documented version in matcha-compiler/README.md"

if [ "$dry_run" = true ]; then
    for pair in \
        "$build_file:$tmp_build" \
        "$package_file:$tmp_package" \
        "$readme_file:$tmp_readme"
    do
        original=${pair%%:*}
        updated=${pair#*:}
        status=0
        diff -u "$original" "$updated" || status=$?
        [ "$status" -le 1 ] || fail "could not show diff for $original"
    done
    exit 0
fi

chmod 0644 "$tmp_build" "$tmp_package" "$tmp_readme"
mv "$tmp_build" "$build_file"
mv "$tmp_package" "$package_file"
mv "$tmp_readme" "$readme_file"
trap - 0 HUP INT TERM
