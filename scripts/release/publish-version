set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

[[ $# -eq 3 ]] || fail "usage: scripts/release/publish-version VERSION TAG EXPECTED_SHA"

version=$1
tag=$2
expected_sha=$3
repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repository_root"

git fetch origin main --tags
scripts/release/set-compiler-version "$version"
origin_main=$(git rev-parse origin/main)

if git show-ref --verify --quiet "refs/tags/$tag"; then
    tag_sha=$(git rev-list -n 1 "$tag")
    [[ "$tag_sha" == "$expected_sha" ]] || fail "existing tag $tag points to $tag_sha, expected $expected_sha"
    exit 0
fi

[[ $(git rev-parse HEAD) == "$origin_main" ]] || fail "origin/main changed while release artifacts were built"

git config user.name "github-actions[bot]"
git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
git add matcha-compiler/build.zig matcha-compiler/build.zig.zon matcha-compiler/README.md

if ! git diff --cached --quiet; then
    git commit -m "Prepare v$version release"
fi

git tag "$tag"
if [[ $(git rev-parse HEAD) == "$origin_main" ]]; then
    git push origin "refs/tags/$tag"
else
    git push --atomic origin HEAD:main "refs/tags/$tag"
fi
