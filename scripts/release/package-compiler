[[ $# -eq 4 ]] || fail "usage: scripts/release/package-compiler VERSION PLATFORM ARCH TEMP_DIRECTORY"

version=$1
platform=$2
arch=$3
temporary_directory=$4
repository_root=${MATCHA_REPOSITORY_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)}
tag="matcha-compiler-v$version"
package_name="$tag-$platform-$arch"
package_directory="$temporary_directory/$package_name"
archive="$PWD/$package_name.tar.gz"

compiler="$repository_root/matcha-compiler/zig-out/bin/matcha"
runtime="$repository_root/matcha-compiler/zig-out/lib/libmatcha_runtime.a"
