#!/usr/bin/env bash
# This file was generated by AI.
set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

[[ $# -eq 2 ]] || fail "usage: scripts/release/validate-published-release TAG RELEASE_REPOSITORY"
[[ -n ${GITHUB_OUTPUT:-} ]] || fail "GITHUB_OUTPUT is required"
[[ -n ${RUNNER_TEMP:-} ]] || fail "RUNNER_TEMP is required"

tag=$1
release_repository=$2
case "$tag" in
    matcha-compiler-v*) version=${tag#matcha-compiler-v} ;;
    *) fail "release tag is not a compiler tag: $tag" ;;
esac
[[ -n "$version" ]] || fail "compiler release version is empty"

repository_root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$repository_root"
git fetch --force origin "refs/tags/$tag:refs/tags/$tag"

release_tree=$(mktemp -d "$RUNNER_TEMP/matcha-release-tree.XXXXXX")
cleanup() {
    rm -rf "$release_tree"
}
trap cleanup EXIT HUP INT TERM

mkdir -p "$release_tree/scripts/release" "$release_tree/matcha-compiler"
cp scripts/release/set-compiler-version "$release_tree/scripts/release/"
for file in build.zig build.zig.zon README.md; do
    git show "$tag:matcha-compiler/$file" > "$release_tree/matcha-compiler/$file"
done
release_version=$("$release_tree/scripts/release/set-compiler-version" --current)
[[ "$release_version" == "$version" ]] || fail "tag $tag contains compiler version $release_version"

release_json="$RUNNER_TEMP/published-release.json"
gh release view "$tag" \
    --repo "$release_repository" \
    --json tagName,isDraft,isPrerelease,assets \
    > "$release_json"

jq -e --arg tag "$tag" '.tagName == $tag and (.isDraft | not) and .isPrerelease' "$release_json" >/dev/null || fail "release $tag is not a published compiler prerelease"
linux_archive="$tag-linux-x86_64.tar.gz"
macos_archive="$tag-macos-arm64.tar.gz"
jq -e \
    --arg linux "$linux_archive" \
    --arg macos "$macos_archive" \
    '([.assets[].name] | contains([$linux, $macos, "SHA256SUMS.txt"]))' \
    "$release_json" >/dev/null || fail "release $tag does not contain all compiler assets"

{
    printf 'tag=%s\n' "$tag"
    printf 'version=%s\n' "$version"
} >> "$GITHUB_OUTPUT"
